# 이 파일을 .env로 복사한 뒤 값을 채우세요. (.env는 git에 올라가지 않습니다)

# Claude로 초안을 쓸 때 (engine = "claude")
ANTHROPIC_API_KEY=

# 워드프레스 주제 (config.toml의 wp_env_prefix와 이름을 맞추세요)
# 워드프레스 관리자 > 사용자 > 프로필 > "응용 프로그램 비밀번호"에서 발급
WP_BMW_URL=https://example.com
WP_BMW_USER=
WP_BMW_APP_PASSWORD=

# 네이버 데이터랩 검색어 트렌드 (python -m blog_autopost trends update)
# 네이버 클라우드 콘솔 > NAVER API HUB 앱의 Client ID / Client Secret
# (예전 네이버 개발자센터 키라면 config.toml 의 [datalab] provider = "developers")
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
